<article class="group bg-zinc-900 border border-green-900/50 hover:border-green-500/70
               rounded-xl p-6 transition-all duration-300 hover:-translate-y-1 flex flex-col col-span-full">
  <div class="flex items-start justify-between mb-3 flex-wrap gap-2">
    <div>
      <span class="text-xs font-mono text-green-400 border border-green-900 px-2 py-0.5 rounded mb-2 inline-block">
        case study
      </span>
      <h3 class="text-xl font-semibold text-zinc-50 group-hover:text-green-400 transition-colors leading-snug">
        <%= link_to case_study.title, project_path(case_study) %>
      </h3>
    </div>
  </div>

  <p class="text-zinc-400 text-sm mb-5 leading-relaxed max-w-3xl"><%= case_study.description %></p>

  <% if case_study.sections.any? %>
    <div class="flex flex-wrap gap-x-6 gap-y-1 mb-5">
      <% case_study.sections.each do |section| %>
        <span class="text-xs font-mono text-zinc-500">
          <span class="text-green-600">&rsaquo;</span> <%= section[:heading] || section["heading"] %>
        </span>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-1.5 mt-auto">
    <% case_study.tech_stack.each do |tech| %>
      <span class="text-xs font-mono bg-zinc-800 text-zinc-400 px-2 py-1 rounded">
        <%= tech %>
      </span>
    <% end %>
  </div>
</article>
